[gd_resource type="Resource" script_class="NarrativeText" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/narrative_text.gd" id="1_nt"]

[resource]
script = ExtResource("1_nt")
menu_title = "Final Thaw"
menu_context = "El protocolo fantasma · demo jugable (Fases 1 y 2, unos 30 minutos)
Helix asegura que el último ensayo de Aster, el protocolo para estabilizar el clima regional, fracasó. Elena Vast, la científica que lo codiseñó, no se lo cree. Esta noche entra sola en la instalación hidrológica de Helix para comprobarlo: medir, deducir y salir sin dejar rastro."
menu_start_button = "Iniciar demo"
hud_oxygen_label = "Oxígeno: %d%%"
hud_civilian_trapped = "Civil: Atrapada"
hud_civilian_rescued = "Civil: Rescatada"
hud_civilian_dead = "Civil: Fallecida"
hud_objective_start = "Objetivo: Activa el generador para restaurar la energía."
hud_objective_power_on = "Objetivo: Abre las válvulas para drenar el agua y continuar."
hud_objective_valves_open = "Objetivo: Decide si rescatas a la civil antes de llegar a la salida."
hud_objective_exit = "Objetivo: Llega a la salida del refugio."
hud_demo_completed = "Demo completada - %s"
hud_demo_failed = "Demo fallida - Elena no sobrevivió"
interact_power_console_off = "Activar generador"
interact_power_console_on = "Generador en marcha"
interact_valve_closed = "Abrir válvula"
interact_valve_open = "Válvula abierta"
interact_civilian_trapped = "Rescatar"
interact_civilian_rescued = "A salvo"
civilian_rescue_lines = Array[String](["Gracias... pensé que no saldría de aquí.", "No pensé que volvería a ver a nadie.", "Mi familia está en el sector norte... ¿puedes llevarles ayuda?", "No tengo fuerzas para seguir. Gracias por intentarlo."])
end_title_success = "Demo completada"
end_title_failure = "Demo fallida"
end_elena_alive = "Elena: Sobrevivió"
end_elena_dead = "Elena: No sobrevivió"
end_civilian_unknown = "Civil: Estado desconocido"
end_power_restored = "Refugio: energía restaurada.\nAlgunos sistemas de emergencia vuelven a estar activos."
end_valves_opened = "Refugio: válvulas abiertas.\nEl agua comenzó a drenar, pero demasiado tarde para algunos."
end_civilian_rescued = "Refugio: civil rescatada.\nUna vida más entre quienes dependen de tus decisiones."
end_civilian_not_rescued = "Refugio: civil no rescatada.\nNo todos pueden salvarse. Esa también es una decisión."
end_button_menu = "Volver al menú"
end_button_restart = "Reiniciar demo"
