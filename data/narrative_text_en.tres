[gd_resource type="Resource" script_class="NarrativeText" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/narrative_text.gd" id="1_nt"]

[resource]
script = ExtResource("1_nt")
menu_title = "Final Thaw\nVertical Slice"
menu_context = "Year 2047. Climate collapse has plunged cities into chaos.\nThe storms do not stop. Shelters flood. People wait for someone\nto make impossible decisions.\n\nElena Vast, scientist of the Aster project, and Marcus Reyes,\nsecurity officer, must cooperate to save what remains of humanity.\n\nIn this demo, you will control Elena in a flooded emergency shelter.\nEvery decision affects those who depend on you."
menu_start_button = "Start Demo"
sound_cue_generator = "[Sound] Generator running"
sound_cue_valves = "[Sound] Valves opening"
sound_cue_rescue = "[Sound] Rescue complete"
sound_cue_oxygen_empty = "[Sound] Oxygen depleted"
cr_breaker_a_response = "The gate light comes on, but the mechanism does not respond."
cr_breaker_b_cooldown = "The panel is still hot. Wait a few seconds."
cr_breaker_b_response = "A spark jumps. This branch's fuse is blown."
cr_breaker_c_response = "Contacts closed. The gate is pressurized."
cr_gate_locked = "The gate is locked. There is no pressure in the mechanism."
cr_gate_open_prompt = "Open gate"
cr_hint_button = "Hint"
cr_hint_level_1 = "Compare the dates on the two logs. Scan near the panels to see where each cable goes."
cr_hint_level_2 = "Panel C powers the east gate."
cr_log_after_body = "Amber circuit out of service: fuse blown after the flood. East gate rerouted through the green circuit."
cr_log_after_title = "Post-incident review"
cr_log_before_body = "East gate: powered by the amber circuit. Contact inspection found no issues."
cr_log_before_title = "Maintenance 14/06"
cr_objective_done = "ROOM CLEARED  /  The gate is open"
cr_objective_start = "OBJECTIVE  /  Open the east gate"
cr_prompt_read_log = "Read log"
cr_prompt_use_breaker = "Use panel"
cr_trace_a = "Light fixture"
cr_trace_b = "Bilge pump"
cr_trace_c = "East gate"
hud_oxygen_label = "Oxygen: %d%%"
hud_civilian_trapped = "Civilian: Trapped"
hud_civilian_rescued = "Civilian: Rescued"
hud_civilian_dead = "Civilian: Deceased"
hud_objective_start = "Objective: Activate the generator to restore power."
hud_objective_power_on = "Objective: Open the valves to drain the water and continue."
hud_objective_valves_open = "Objective: Decide whether to rescue the civilian before reaching the exit."
hud_objective_exit = "Objective: Reach the shelter exit."
hud_demo_completed = "Demo completed - %s"
hud_demo_failed = "Demo failed - Elena did not survive"
interact_power_console_off = "Activate generator"
interact_power_console_on = "Generator running"
interact_valve_closed = "Open valve"
interact_valve_open = "Valve open"
interact_civilian_trapped = "Rescue"
interact_civilian_rescued = "Safe"
civilian_rescue_lines = Array[String](["Thank you... I thought I wouldn't make it out of here.", "I didn't think I'd see anyone again.", "My family is in the northern sector... can you bring them help?", "I don't have the strength to go on. Thanks for trying."])
end_title_success = "Demo Complete"
end_title_failure = "Demo Failed"
end_elena_alive = "Elena: Survived"
end_elena_dead = "Elena: Did not survive"
end_civilian_unknown = "Civilian: Status unknown"
end_power_restored = "Shelter: power restored.\nSome emergency systems are back online."
end_valves_opened = "Shelter: valves opened.\nThe water began to drain, but too late for some."
end_civilian_rescued = "Shelter: civilian rescued.\nOne more life among those who depend on your decisions."
end_civilian_not_rescued = "Shelter: civilian not rescued.\nNot everyone can be saved. That is also a decision."
end_button_menu = "Back to Menu"
